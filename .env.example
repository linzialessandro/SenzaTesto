# Segreti del progetto SenzaTesto
# Per lo sviluppo locale, crea ~/secrets/SenzaTesto/.env con queste variabili.
# In CI/CD, usa GitHub Secrets.

DATABASE_URL=postgresql://[UTENTE]:[PASSWORD]@[HOST]:6543/[DATABASE]
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_[CHIAVE]
ALLOWED_ORIGINS=http://localhost:3000,https://linzialessandro.github.io
